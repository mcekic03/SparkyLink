{
  "extends": "@app/tsconfig/base.json",
  "include": ["**/*.ts", "**/*.tsx", "vite.config.js"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": {
      "#/*": ["./src/*"],
      "@app/ui/*": ["../../packages/ui/src/*"]
    },
    "types": ["vite/client"]
  }
}
