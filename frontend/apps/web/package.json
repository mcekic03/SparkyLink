    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.19.0",
    "date-fns": "^4.4.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.28.0",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "react": "catalog:",
    "react-day-picker": "^10.0.1",
    "react-dom": "catalog:",
    "react-i18next": "^17.0.11",
