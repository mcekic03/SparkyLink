    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.5",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
