# Vrednosti koje stack ocekuje (docker-compose.yml).
#
# Lokalno:   kopiraj u `.env`, popuni tajne, pa
#            docker network create proxy            (jednom)
#            docker compose up -d --build
# Portainer: prekopiraj parove u "Environment variables" stack-a (Advanced mode).
#
# U vrednostima izbegavaj znak `$` (Compose ga tumaci kao promenljivu).

# --- Aplikacija ---
# docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_DEBUG=false
# Domen aplikacije (Traefik, Let's Encrypt). Samo domen, bez https://. DNS mora da
# pokazuje na server pre deploy-a. Lokalno: localhost.
APP_DOMAIN=sparkylink.cekic-elektrik.rs
LOG_LEVEL=warning

# --- Baza --- (DB_USERNAME ne sme biti "root"; lozinke bez znaka $)
DB_DATABASE=sparkylink
DB_USERNAME=sparkylink
DB_PASSWORD=
DB_ROOT_PASSWORD=
MYSQL_BUFFER_POOL=256M
DB_WAIT_TIMEOUT=60

# --- Prvi nalog (vlasnik, super administrator), pravi se pri prvom startu ---
# SECRET_PASSWORD je obavezan; bez njega se baza ne priprema (migracija javlja gresku).
ADMIN_EMAIL=ceka.mihajlo03@gmail.com
SECRET_PASSWORD=

# --- Traefik na serveru (podrazumevano kao Stara Vodenica) ---
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT_WEB=web
TRAEFIK_ENTRYPOINT_SECURE=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# --- Otpremanje i PHP ---
UPLOAD_MAX_SIZE=600M
PHP_MEMORY_LIMIT=256M

# --- Rezervne kopije (volumen `backups`) ---
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=30

# --- Samo lokalno (docker-compose.override.yml; na serveru bez efekta) ---
HTTP_PORT=80
HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8090
DB_PORT_HOST=3310
WEB_DEV_PORT=3000
