APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SPA_URL=http://localhost:8000

APP_TIMEZONE=UTC
SCHEDULER_TIMEZONE="Europe/Belgrade"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,discord,slack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Discord Logging
LOG_DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_CHANNEL/YOUR_TOKEN"
LOG_INTERVAL=5
LOG_RATE_LIMITER=10

# Slack Logging (Ultimate Handler)
LOG_SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR_HOOK_ENDPOINT"
LOG_SLACK_CHANNEL="#errors"
LOG_SLACK_USERNAME="Laravel Logger"
LOG_SLACK_EMOJI=":rotating_light:"
LOG_SLACK_LEVEL=error
LOG_SLACK_RATE_LIMIT=20
LOG_SLACK_RATE_INTERVAL=60
LOG_SLACK_STACK_TRACE=true
LOG_SLACK_STACK_TRACE_LIMIT=10

# Lozinka prvog naloga (obavezna, samo u lokalnom .env, nikad u repozitorijumu)
ADMIN_EMAIL=ceka.mihajlo03@gmail.com
SECRET_PASSWORD=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=larastarter_db
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Running docker locally

# Default UID and GID for system user
# Check which ID your user has with command `id`
UID=1000
GID=1000

# Default port for accessing application
# change it if it is conflicting port with other services
API_PORT=8000

# Port for accessing with external tools like tableplus, not needed for PhpMyAdmin or the app
# Change if default conflicts with locally running database (ie. XAMPP)
MYSQL_EXTERNAL_PORT=3307

# Port for accessing PMA, change if conflicting with other apps
PMA_PORT=8081

# PHP config
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=300
PHP_MAX_INPUT_TIME=300
